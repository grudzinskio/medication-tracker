# Copy this file to .env and fill in your MySQL credentials.
# Do not commit .env to version control.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=Medication_Tracker

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Email (doctor messages + adherence reminders)
# ─ Production: set all SMTP_* — mail goes to real addresses via your provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=medication-tracker@localhost
#
# ─ Easy free real inbox delivery (pick one provider; limits change — check their pricing page):
#
#   **Resend** (simple): https://resend.com → sign up → API Keys → create a key.
#   SMTP tab in their docs: host smtp.resend.com, port 587, username MUST be exactly: resend
#   Password = your API key (starts with re_). MAIL_FROM must be a sender/domain they allow
#   (verify a domain in Resend, or use whatever “test sender” they show in the dashboard).
#
#   Example (DO NOT commit real keys — paste into your local .env only):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxx
#   MAIL_FROM="Medication Tracker <notifications@your-verified-domain.com>"
#
#   Other common free SMTP tiers: Brevo, SendGrid, Mailjet — use the SMTP host/port/user/pass from their docs.
#
# ─ Dev default (when SMTP_* are empty): Ethereal fake SMTP — preview link only, not a real inbox.
#
# ─ MAIL_CONSOLE_ONLY=1 — skip Ethereal; print mail to the API terminal only (offline-friendly).

# Login rate limit (per IP, per 15 minutes)
LOGIN_RATE_LIMIT_MAX=60

# Set to 0 to disable the daily adherence reminder cron job
ADHERENCE_REMINDER_CRON=1
